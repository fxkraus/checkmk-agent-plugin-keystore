#!/bin/bash
# CheckMK Agent Plugin: Java Keystore Certificate Expiry Monitor
#
# Monitors certificate expiry in Java keystores (JKS and PKCS12).
# Configuration is read from $MK_CONFDIR/keystore.cfg
#
# Config file format (INI-style, one section per keystore):
#
#   [/path/to/keystore.jks]
#   password=changeit
#   aliases=ALL
#   keytool=/usr/bin/keytool
#   storetype=JKS
#
#   [/path/to/keystore.p12]
#   password=secret
#   aliases=myalias,otheralias
#
# Section header: keystore file path in square brackets.
# password:  Keystore password (required).
# aliases:   Comma-separated alias list or "ALL" (default: ALL). Matched
#            case-insensitively; aliases not found are reported as errors.
# keytool:   Path to keytool binary (default: /usr/bin/keytool).
# storetype: JKS, PKCS12, or omit for auto-detection.
#
# Output format (<<<keystore>>> section, pipe-separated):
#   <path>|<alias>|<expiry_epoch>|<days_remaining>|<subject>
#   ERROR|<path>|<message>
#
# Copyright 2026 Felix Kraus (https://github.com/fxkraus)
# License: MIT

# Plugin version — stamped during MKP build
CMK_VERSION="0.0.0"

set -o noglob

readonly CMD_TIMEOUT=30

# --- Validate environment ---
if [[ -z "${MK_CONFDIR:-}" ]]; then
    # No agent environment — cannot locate config
    exit 0
fi

readonly CONFIG_FILE="${MK_CONFDIR}/keystore.cfg"

if [[ ! -f "${CONFIG_FILE}" ]]; then
    # Plugin not configured — exit silently
    exit 0
fi

# --- Process a single keystore ---
check_keystore() {
    local ks_path="$1"
    local ks_pass="$2"
    local ks_aliases="$3"
    local ks_keytool="$4"
    local ks_storetype="$5"

    # Validate keystore file
    if [[ ! -f "$ks_path" ]]; then
        echo "ERROR|${ks_path}|Keystore file not found"
        return
    fi

    # Validate keytool binary
    if ! command -v "$ks_keytool" >/dev/null 2>&1; then
        echo "ERROR|${ks_path}|keytool not found at ${ks_keytool}"
        return
    fi

    # Password is passed via environment so it does not show up in ps/proc cmdline
    local -a keytool_args=(-list -v -keystore "$ks_path" -storepass:env KS_PASS)
    if [[ -n "$ks_storetype" ]]; then
        keytool_args+=(-storetype "$ks_storetype")
    fi

    # stdin from /dev/null: keytool must not consume the config file being read by main()
    # TZ=UTC: keeps the `until:` dates independent of local zone abbreviations `date -d` may not know
    local keytool_output
    keytool_output=$(KS_PASS="$ks_pass" TZ=UTC timeout "${CMD_TIMEOUT}s" "$ks_keytool" "${keytool_args[@]}" 2>&1 < /dev/null)
    local rc=$?
    if [[ $rc -ne 0 ]]; then
        local err_msg
        err_msg=$(echo "$keytool_output" | head -1)
        echo "ERROR|${ks_path}|keytool failed (rc=${rc}): ${err_msg}"
        return
    fi

    # Build alias filter set, keyed by lowercase alias (JKS stores aliases lowercased)
    local -A filter_set
    local -A seen_set
    local filter_all=1
    local a
    if [[ "$ks_aliases" != "ALL" ]]; then
        filter_all=0
        local -a alias_arr
        IFS=',' read -ra alias_arr <<< "$ks_aliases"
        for a in "${alias_arr[@]}"; do
            # Trim whitespace
            a="${a#"${a%%[![:space:]]*}"}"
            a="${a%"${a##*[![:space:]]}"}"
            [[ -n "$a" ]] && filter_set["${a,,}"]="$a"
        done
    fi

    # Parse keytool output
    local current_alias=""
    local current_owner=""
    local got_expiry=0
    local now_ts
    now_ts=$(date +%s)

    while IFS= read -r line; do
        # Strip carriage return
        line="${line%$'\r'}"

        # Detect new alias entry
        if [[ "$line" =~ ^Alias\ name:\ (.*) ]]; then
            current_alias="${BASH_REMATCH[1]}"
            # Trim trailing whitespace
            current_alias="${current_alias%"${current_alias##*[![:space:]]}"}"
            current_owner=""
            got_expiry=0
            seen_set["${current_alias,,}"]=1
            continue
        fi

        # Skip if no current alias
        [[ -z "$current_alias" ]] && continue

        # Check alias filter
        if [[ $filter_all -eq 0 ]] && [[ -z "${filter_set[${current_alias,,}]+x}" ]]; then
            continue
        fi

        # Capture owner (first occurrence per alias)
        if [[ -z "$current_owner" && "$line" =~ ^Owner:\ (.*) ]]; then
            current_owner="${BASH_REMATCH[1]}"
            continue
        fi

        # Capture expiry (first "until:" per alias = leaf certificate)
        if [[ $got_expiry -eq 0 && "$line" =~ until:\ (.*) ]]; then
            got_expiry=1
            local expiry_str="${BASH_REMATCH[1]}"

            local expiry_ts
            expiry_ts=$(date -d "$expiry_str" +%s 2>/dev/null) || {
                echo "ERROR|${ks_path}|Cannot parse expiry for alias '${current_alias}'"
                continue
            }

            local days_remaining=$(( (expiry_ts - now_ts) / 86400 ))
            echo "${ks_path}|${current_alias}|${expiry_ts}|${days_remaining}|${current_owner}"
        fi
    done <<< "$keytool_output"

    # Configured aliases absent from the keystore must not drop out of monitoring silently
    for a in "${!filter_set[@]}"; do
        if [[ -z "${seen_set[$a]+x}" ]]; then
            echo "ERROR|${ks_path}|Alias '${filter_set[$a]}' not found in keystore"
        fi
    done
}

# --- Main ---
main() {
    echo "<<<keystore:sep(124)>>>"

    local current_path=""
    local current_pass=""
    local current_aliases="ALL"
    local current_keytool="/usr/bin/keytool"
    local current_storetype=""

    process_current() {
        if [[ -n "$current_path" ]]; then
            check_keystore "$current_path" "$current_pass" \
                "$current_aliases" "$current_keytool" "$current_storetype"
        fi
    }

    while IFS= read -r line || [[ -n "$line" ]]; do
        # Strip carriage returns
        line="${line%$'\r'}"

        # Skip comments and empty lines
        [[ "$line" =~ ^[[:space:]]*# ]] && continue
        [[ -z "$line" || "$line" =~ ^[[:space:]]*$ ]] && continue

        # Section header: [/path/to/keystore]
        if [[ "$line" =~ ^\[(.+)\]$ ]]; then
            # Capture before process_current, whose regex matches overwrite BASH_REMATCH
            local next_path="${BASH_REMATCH[1]}"
            process_current
            current_path="$next_path"
            current_pass=""
            current_aliases="ALL"
            current_keytool="/usr/bin/keytool"
            current_storetype=""
            continue
        fi

        # Key=value pairs
        if [[ "$line" =~ ^([a-zA-Z_]+)=(.*) ]]; then
            local key="${BASH_REMATCH[1]}"
            local value="${BASH_REMATCH[2]}"
            case "$key" in
                password)  current_pass="$value" ;;
                aliases)   current_aliases="$value" ;;
                keytool)   current_keytool="$value" ;;
                storetype) current_storetype="$value" ;;
            esac
        fi
    done < "$CONFIG_FILE"

    # Process last entry
    process_current
}

main
